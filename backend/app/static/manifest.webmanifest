{
  "name": "roadSOS - Roadside Emergency",
  "short_name": "roadSOS",
  "description": "Tap-and-hold emergency dispatch for roadside rescue with live GPS.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f6f3ee",
  "theme_color": "#f4c89a",
  "lang": "en",
  "dir": "ltr",
  "categories": ["utilities", "navigation", "lifestyle"],
  "icons": [
    {
      "src": "/static/icons/icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-192-maskable.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    },
    {
      "src": "/static/icons/icon-512-maskable.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    },
    {
      "src": "/static/icons/favicon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Call 112",
      "short_name": "112",
      "description": "Open SOS screen with the giant tap button",
      "url": "/?source=pwa-shortcut-sos",
      "icons": [
        { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "Find services",
      "short_name": "Services",
      "description": "Pick a specific responder (ambulance, tow, police, fuel)",
      "url": "/services?source=pwa-shortcut-services",
      "icons": [
        { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ],
  "prefer_related_applications": false
}
